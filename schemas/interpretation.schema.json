{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/causal-thread/v0.3/interpretation.schema.json",
  "title": "Causal Thread v0.3 consequence draft",
  "type": "object",
  "required": [
    "id",
    "summary",
    "interpretation",
    "origin",
    "operations",
    "support_ids",
    "belief_ids",
    "actor_id",
    "visible_to",
    "public_summary",
    "open_questions",
    "base_revision",
    "base_hash"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "interpretation": {
      "type": "string",
      "minLength": 1
    },
    "origin": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "observation",
            "native_oracle",
            "tbe_oracle",
            "native_test",
            "tbe_rule",
            "referee"
          ]
        }
      },
      "additionalProperties": true
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "op"
        ],
        "properties": {
          "op": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "support_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "belief_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "actor_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "visible_to": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "public_summary": {
      "type": "string"
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "base_revision": {
      "type": "integer",
      "minimum": 0
    },
    "base_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "additionalProperties": false
}
